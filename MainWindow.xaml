<Window x:Class="DefectoscopyAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="Анализ дефектоскопии" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Для кнопки -->
            <RowDefinition Height="*"/>
            <!-- Для графика -->
            <RowDefinition Height="Auto"/>
            <!-- Для информации о дефектах -->
        </Grid.RowDefinitions>

        <Button Grid.Row="0" 
                Content="Начать анализ" 
                Click="AnalyzeButton_Click" 
                Margin="5" Width="100" HorizontalAlignment="Left"/>

        <oxy:PlotView x:Name="plotView" Grid.Row="1" Margin="5"/>

    </Grid>
</Window>