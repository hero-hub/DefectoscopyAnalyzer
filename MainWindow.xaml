<Window x:Class="DefectoscopyAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:local="clr-namespace:DefectoscopyAnalyzer" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="Анализ дефектоскопии" Height="800" Width="1000">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:BooleanInverterConverter x:Key="BooleanInverterConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" 
                Content="Начать анализ" 
                Command="{Binding Analyze}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource BooleanInverterConverter}}"
                Margin="5" Width="100" HorizontalAlignment="Left"/>

        <oxy:PlotView x:Name="plotView" 
              Grid.Row="1"
              Model="{Binding PlotModel}"
              Margin="5"/>

        <Border Grid.Row="2" 
                BorderBrush="Gray" 
                BorderThickness="1"
                Margin="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding DefectsInfoText}" 
                           Margin="5" 
                           TextWrapping="Wrap" 
                           FontSize="14"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>